@echo off
echo Starting Aaaayasofya E-Commerce Website...
echo.

echo [1/2] Starting Backend (Port 5000)...
start "Aaaayasofya Backend" cmd /k "cd /d "%~dp0backend" && npm start"

timeout /t 3 /nobreak > nul

echo [2/2] Starting Frontend (Port 5173)...
start "Aaaayasofya Frontend" cmd /k "cd /d "%~dp0frontend" && npm run dev"

echo.
echo ============================================
echo  Aaaayasofya is starting up!
echo ============================================
echo  Store:       http://localhost:5173
echo  Admin Panel: http://localhost:5173/admin
echo  Admin Login: admin@Aaaayasofya.com / admin123
echo  API:         http://localhost:5000/api
echo ============================================
echo.
pause
